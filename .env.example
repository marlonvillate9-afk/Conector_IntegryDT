# Copiar este archivo como .env y completar los valores locales.
INTEGRY_BACKEND_URL=http://127.0.0.1:5080
INTEGRY_COMPANY_SLUG=integry-dt-development

# Debe ser exactamente la misma clave configurada en el backend.
INTEGRY_CLIENT_ENROLLMENT_KEY=CAMBIAR_POR_UNA_CLAVE_SEGURA

# Opcionales. Si no se definen se usan los valores por defecto del cliente.
# INTEGRY_GADGET_CACHE=C:\ProgramData\IntegryDT\GadgetCache
# INTEGRY_GADGET_PUBLIC_KEY=C:\ProgramData\IntegryDT\Keys\gadget-public.pem
